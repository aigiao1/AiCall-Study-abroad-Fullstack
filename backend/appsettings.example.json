{
  "_comment": "Copy this file to appsettings.json and fill in your real values, or set the equivalent environment variables (e.g. LLM__ApiKey). Environment variables take precedence.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=AICallDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JWT": {
    "Issuer": "http://localhost:7003",
    "Audience": "http://localhost:5175",
    "SigningKey": "<your-jwt-signing-key-at-least-64-chars>"
  },
  "LLM": {
    "BaseUrl": "https://your-llm-proxy.example.com/v1/",
    "ApiKey": "<your-llm-api-key>",
    "ModelName": "gpt-4.1-mini"
  },
  "ASR": {
    "BaseUrl": "https://your-asr-proxy.example.com/v1/",
    "ApiKey": "<your-asr-api-key>",
    "ModelName": "whisper-1"
  },
  "TTS": {
    "BaseUrl": "https://your-tts-proxy.example.com/v1/",
    "ApiKey": "<your-tts-api-key>",
    "ModelName": "gpt-4o-mini-tts",
    "Voice": "alloy"
  }
}
