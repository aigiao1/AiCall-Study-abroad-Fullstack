{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node", 
    "allowJs": true,
    "checkJs": false, 
    "strict": false,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"] 
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}